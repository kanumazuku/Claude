# 使いたいAIのAPIキーだけを設定してください。未設定のAIは画面で選べなくなります。
# キーが1つもなくても「デモ」AIで動作を試せます。

# --- Claude（Anthropic）---
ANTHROPIC_API_KEY=
COUNCIL_CLAUDE_MODEL=claude-opus-5-5
# 思考の深さ：low / medium / high / xhigh / max（深いほど時間と費用がかかります）
COUNCIL_CLAUDE_EFFORT=medium

# --- GPT（OpenAI）---
OPENAI_API_KEY=
COUNCIL_OPENAI_MODEL=gpt-5.5

# --- Gemini（Google）---
GEMINI_API_KEY=
COUNCIL_GEMINI_MODEL=gemini-3.8-flash

# --- ローカルLLM（Ollama）---
# Ollamaを起動しておくと自動で検出されます。
OLLAMA_HOST=http://localhost:11434
COUNCIL_OLLAMA_MODEL=gemma3

# --- デモAI ---
# 文字を流す間隔（秒）。0にすると一瞬で表示されます。
COUNCIL_MOCK_DELAY=0.015

# --- サーバー ---
COUNCIL_HOST=127.0.0.1
COUNCIL_PORT=8000
